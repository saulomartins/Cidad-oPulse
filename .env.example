# ============================================================
# CidadãoPulse - Configurações de Ambiente
# ============================================================
# Banco de dados SQLite (padrão local na pasta backend/data)
DATABASE_URL=sqlite:///./data/cidadao_pulse.db

# --- Motor de IA e Busca Web (Google Gemini) ---
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# --- Conectores Opcionais de Redes Sociais (Plugáveis) ---
# YouTube Data API v3 (gratuita com cota diária)
YOUTUBE_API_KEY=
# Apify (Instagram, TikTok, Facebook, X/Twitter via actors)
APIFY_TOKEN=
# X (Twitter) API v2 Bearer Token
X_BEARER_TOKEN=
# Meta Graph API (Facebook / Instagram Business)
META_ACCESS_TOKEN=

# --- Agendamento Automático ---
AWARDS_CRON_DAY=mon
AWARDS_CRON_HOUR=8
AWARDS_CRON_MINUTE=0
SENTIMENT_INTERVAL_HOURS=12

# --- Alertas por Webhook (Slack / Microsoft Teams / Genérico) ---
WEBHOOK_URL=
WEBHOOK_PROVIDER=slack

# --- Alertas por E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
